{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(npm create *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(curl -s http://localhost:5173/ -o /dev/null -w \"HTTP %{http_code}\\\\n\")",
      "Bash(curl -s http://localhost:5173/src/main.tsx -o /dev/null -w \"main.tsx HTTP %{http_code}\\\\n\")",
      "Bash(curl -s http://localhost:5173/src/__TRACKED_VAR__ -o /dev/null -w '%{http_code}')",
      "Bash(curl -s \"http://localhost:5173/src/components/primitives/GlobalBackground.tsx\" -o /dev/null -w \"GlobalBackground -> %{http_code}\\\\n\")",
      "Bash(curl -s \"http://localhost:5173/src/App.tsx\" -o /dev/null -w \"App -> %{http_code}\\\\n\")",
      "Bash(pkill -f \"vite\")",
      "PowerShell(Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -ge 5173 -and $_.LocalPort -le 5180 } | Select-Object LocalAddress, LocalPort, OwningProcess)"
    ]
  }
}
